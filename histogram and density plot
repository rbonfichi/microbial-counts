# R Code: Read Data from Excel and Plot Histogram + Density Plot


# Load the libraries
library(ggplot2) # For visualization
library(readxl) # For reading Excel files

# Define the file path (update this with your actual file path)
file_path <- "C:/Users/Utente/Desktop/Sligthly overdispersed Simulated Microbial Count Data/Histogram with density plot/simul sligthly overdisp data.xlsx" 

# Read the data from Excel (assuming data is in the first sheet, first column)
df <- read_excel(file_path, skip = 1, col_names = FALSE)  # Skips the first row


# Convert to a numeric vector
data <- as.numeric(df[[1]])  

# Create a data frame for ggplot
df_plot <- data.frame(Value = data)

# Create the histogram with density plot
ggplot(df_plot, aes(x = Value)) +
  geom_histogram(aes(y = ..density..), 
                 bins = 10, 
                 fill = "blue", 
                 color = "black", 
                 alpha = 0.6) +  # Transparency
  geom_density(color = "red", size = 1.2) +  # Density line
  theme_minimal() +  # Clean theme
  labs(title = "Histogram of Sligthy Overdispersed Simulated Microbial Count Data with Density Plot",
       x = "Counts",
       y = "Density") +
  theme(plot.title = element_text(hjust = 0.5))  # Center title

















